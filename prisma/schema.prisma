generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  phone String?
  phoneVerified Boolean @default(false)
  status String @default("PENDING")
  role String @default("USER")
  otpVerifiedAt DateTime?
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  wallet Wallet?
  challenges OtpChallenge[]
  tokens MemberToken[]
  cards RfidCard[]
  shifts StaffShift[]
  cashierSales PosTransaction[] @relation("PosCashier")
  paymentNotices MemberNotice[] @relation("NoticeMember")
  cashierNotices MemberNotice[] @relation("NoticeCashier")
  adminMfa AdminMfa?
  adminGrants AdminGrant[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([provider,providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model OtpChallenge {
  id String @id @default(cuid())
  userId String
  digest String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([userId,createdAt])
}
model Wallet {
  id String @id @default(cuid())
  userId String @unique
  balance Int @default(0)
  user User @relation(fields:[userId],references:[id])
  entries LedgerEntry[]
  intents TopupIntent[]
}
model LedgerTransaction {
  id String @id @default(cuid())
  key String @unique
  fingerprint String
  kind String
  actorId String
  reference String?
  createdAt DateTime @default(now())
  entries LedgerEntry[]
  pos PosTransaction?
  @@index([createdAt])
}
model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  walletId String?
  account String
  side String
  amount Int
  transaction LedgerTransaction @relation(fields:[transactionId],references:[id])
  wallet Wallet? @relation(fields:[walletId],references:[id])
  @@index([walletId,transactionId])
}
model TopupIntent {
  id String @id @default(cuid())
  key String @unique
  walletId String
  amount Int
  requestedAmount Int?
  currency String @default("THB")
  status String @default("PENDING")
  provider String @default("sandbox")
  paymentRef String? @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields:[walletId],references:[id])
  webhooks PaymentWebhook[]
  slipUploads SlipUpload[]
}
model PaymentWebhook {
  id String @id
  intentId String
  digest String
  receivedAt DateTime @default(now())
  intent TopupIntent @relation(fields:[intentId],references:[id])
}
model MemberToken {
  id String @id @default(cuid())
  digest String @unique
  userId String
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields:[userId],references:[id])
  notices MemberNotice[]
  @@index([userId])
}
model PosTerminal {
  id String @id
  name String
  active Boolean @default(true)
  locked Boolean @default(false)
  shifts StaffShift[]
  sales PosTransaction[]
}
model StaffShift {
  id String @id @default(cuid())
  userId String
  terminalId String
  openedAt DateTime @default(now())
  closedAt DateTime?
  user User @relation(fields:[userId],references:[id])
  terminal PosTerminal @relation(fields:[terminalId],references:[id])
  transactions PosTransaction[]
}
model PosTransaction {
  id String @id @default(cuid())
  ledgerId String @unique
  shiftId String?
  cashierId String?
  terminalId String?
  amount Int
  memberId String
  refunded Int @default(0)
  balanceBefore Int?
  balanceAfter Int?
  borrowed Int @default(0)
  overdraftApproved Boolean @default(false)
  ledger LedgerTransaction @relation(fields:[ledgerId],references:[id])
  shift StaffShift? @relation(fields:[shiftId],references:[id])
  cashier User? @relation("PosCashier",fields:[cashierId],references:[id])
  terminal PosTerminal? @relation(fields:[terminalId],references:[id])
  @@index([cashierId])
}
model RfidCard {
  id String @id @default(cuid())
  userId String
  credentialRef String @unique
  status String @default("PENDING_PROVISION")
  revokedAt DateTime?
  user User @relation(fields:[userId],references:[id])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  detail String?
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
  @@index([action,targetId])
}
model AdminMfa {
 userId String @id
 secret String
 enabled Boolean @default(false)
 lastCounter BigInt @default(-1)
 pendingSession String
 expiresAt DateTime
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
model AdminGrant {
 digest String @id
 userId String
 sessionHash String
 expiresAt DateTime
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,sessionHash])
}

model MemberNotice {
 id String @id @default(cuid())
 key String @unique
 userId String
 cashierId String
 tokenId String
 amount Int
 balance Int
 status String @default("INSUFFICIENT")
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation("NoticeMember",fields:[userId],references:[id])
 cashier User @relation("NoticeCashier",fields:[cashierId],references:[id])
 token MemberToken @relation(fields:[tokenId],references:[id],onDelete:Cascade)
 @@index([userId,expiresAt])
 @@index([tokenId])
}

model SlipUpload {
  id String @id @default(cuid())
  imageHash String @unique
  intentId String
  lease String
  leaseUntil DateTime
  createdAt DateTime @default(now())
  intent TopupIntent @relation(fields:[intentId],references:[id])
  @@index([intentId,leaseUntil])
}

model ConnextReservation {
 amount Int @id
 intentId String @unique
 holdUntil DateTime
 @@index([holdUntil])
}
model ConnextJob {
 id String @id
 amount Int
 account String
 paidAt DateTime
 receivedAt DateTime @default(now())
 status String @default("PENDING")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 lastError String?
 @@index([status,availableAt])
}
model ConnextWorker {
 id String @id
 lease String
 lockedUntil DateTime
}

model ConnextHealth {
 id String @id
 status String
 reason String
 lastHeartbeat DateTime?
 changedAt DateTime @default(now())
}
model ConnextAlert {
 id String @id @default(uuid())
 retryKey String @unique @default(uuid())
 text String
 status String @default("PENDING")
 attempts Int @default(0)
 availableAt DateTime @default(now())
 createdAt DateTime @default(now())
 sentAt DateTime?
 @@index([status,availableAt])
}
