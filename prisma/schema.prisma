generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  phone String?
  phoneVerified Boolean @default(false)
  status String @default("PENDING")
  role String @default("USER")
  otpVerifiedAt DateTime?
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  wallet Wallet?
  challenges OtpChallenge[]
  tokens MemberToken[]
  cards RfidCard[]
  shifts StaffShift[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([provider,providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model OtpChallenge {
  id String @id @default(cuid())
  userId String
  digest String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id])
  @@index([userId,createdAt])
}
model Wallet {
  id String @id @default(cuid())
  userId String @unique
  balance Int @default(0)
  user User @relation(fields:[userId],references:[id])
  entries LedgerEntry[]
  intents TopupIntent[]
}
model LedgerTransaction {
  id String @id @default(cuid())
  key String @unique
  fingerprint String
  kind String
  actorId String
  reference String?
  createdAt DateTime @default(now())
  entries LedgerEntry[]
  pos PosTransaction?
}
model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  walletId String?
  account String
  side String
  amount Int
  transaction LedgerTransaction @relation(fields:[transactionId],references:[id])
  wallet Wallet? @relation(fields:[walletId],references:[id])
  @@index([walletId,transactionId])
}
model TopupIntent {
  id String @id @default(cuid())
  key String @unique
  walletId String
  amount Int
  currency String @default("THB")
  status String @default("PENDING")
  provider String @default("sandbox")
  paymentRef String? @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields:[walletId],references:[id])
  webhooks PaymentWebhook[]
}
model PaymentWebhook {
  id String @id
  intentId String
  digest String
  receivedAt DateTime @default(now())
  intent TopupIntent @relation(fields:[intentId],references:[id])
}
model MemberToken {
  id String @id @default(cuid())
  digest String @unique
  userId String
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields:[userId],references:[id])
  @@index([userId])
}
model PosTerminal {
  id String @id
  name String
  active Boolean @default(true)
  locked Boolean @default(false)
  shifts StaffShift[]
}
model StaffShift {
  id String @id @default(cuid())
  userId String
  terminalId String
  openedAt DateTime @default(now())
  closedAt DateTime?
  user User @relation(fields:[userId],references:[id])
  terminal PosTerminal @relation(fields:[terminalId],references:[id])
  transactions PosTransaction[]
}
model PosTransaction {
  id String @id @default(cuid())
  ledgerId String @unique
  shiftId String
  amount Int
  memberId String
  refunded Int @default(0)
  ledger LedgerTransaction @relation(fields:[ledgerId],references:[id])
  shift StaffShift @relation(fields:[shiftId],references:[id])
}
model RfidCard {
  id String @id @default(cuid())
  userId String
  credentialRef String @unique
  status String @default("PENDING_PROVISION")
  revokedAt DateTime?
  user User @relation(fields:[userId],references:[id])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  detail String?
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
}