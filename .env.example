DATABASE_URL=postgresql://canteen:canteen_local_only@localhost:5432/canteen
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
APP_ORIGIN=http://localhost:3000
OTP_PEPPER=
RESEND_API_KEY=
EMAIL_FROM=Smart Canteen <noreply@your-verified-domain.example>
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PAYMENT_MODE=sandbox
SANDBOX_WEBHOOK_SECRET=
# Real slip topups: PAYMENT_MODE=slip2go after receiver configuration and live verification. Never use sandbox for real money.
# Set locally generated random 32-byte or longer secrets; never commit .env.
# Email adapter: brevo or resend. Brevo may use an already verified sender address.
EMAIL_PROVIDER=resend
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Vercel Upstash integration also supports KV_REST_API_URL / KV_REST_API_TOKEN.

# Admin TOTP encryption derives a separate key from AUTH_SECRET via HKDF.
# Keep AUTH_SECRET stable/backed up; rotating requires planned MFA re-enrollment.
# No extra email provider credentials or sends are needed for Authenticator MFA.

# Slip2Go REST API (server-only). See docs/SLIP2GO.md. Never use NEXT_PUBLIC_.
SLIP2GO_SECRET_KEY=
TOPUP_BANK_CODE=
TOPUP_BANK_ACCOUNT=
TOPUP_ACCOUNT_NAME=
# Initial adapter supports Thai mobile-number PromptPay only.
TOPUP_PROMPTPAY=
CONNEXT_AGENT_SECRET=
# Server-only LINE receiver outage/recovery notifications (own user ID only).
MONITOR_LINE_TOKEN=
MONITOR_LINE_USER_ID=
